<Page x:Class="RoboUI.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:RoboUI.ViewModels"
      xmlns:b="clr-namespace:RoboUI.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
      Title="Home"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll=False turns off the NavigationView's own scroll wrapper: this page scrolls itself,
       so the action bar below can stay fixed at the bottom. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,8,24,24">

      <!-- Job settings: locked while a copy runs -->
      <StackPanel IsEnabled="{Binding CanEdit}">

        <!-- Folders -->
        <ui:Card Margin="0,0,0,12" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Style="{StaticResource CardHeader}" Text="Folders" />

            <!-- Swap: spans both folder rows, between them visually -->
            <ui:Button Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Margin="8,0,0,0" Padding="8"
                       VerticalAlignment="Center"
                       ToolTip="Swap source and destination"
                       AutomationProperties.Name="Swap folders"
                       Command="{Binding SwapFoldersCommand}">
              <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18">
                <ui:SymbolIcon.LayoutTransform>
                  <RotateTransform Angle="90" />
                </ui:SymbolIcon.LayoutTransform>
              </ui:SymbolIcon>
            </ui:Button>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Source" />
            <ui:TextBox Grid.Row="2" Margin="0,0,8,12"
                        PlaceholderText="Choose a folder or drag one here"
                        Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                        b:FolderDrop.IsEnabled="True" />
            <ui:Button Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Content="Browse…"
                       Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseSourceCommand}" />

            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Destination" />
            <ui:TextBox Grid.Row="4" Margin="0,0,8,0"
                        PlaceholderText="Choose a folder or drag one here"
                        Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                        b:FolderDrop.IsEnabled="True" />
            <ui:Button Grid.Row="4" Grid.Column="1" Content="Browse…"
                       Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseDestinationCommand}" />
          </Grid>
        </ui:Card>

        <!-- Mode: one choice, each option explains itself (the legend) -->
        <ui:Card Margin="0,0,0,12" Padding="16">
          <StackPanel>
            <TextBlock Style="{StaticResource CardHeader}" Text="Mode" />
            <UniformGrid Columns="3">
              <RadioButton GroupName="Mode" Margin="0,0,12,0" VerticalContentAlignment="Top"
                           IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Copy}">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="Copy" />
                  <TextBlock Style="{StaticResource Legend}"
                             Text="Copies new and changed files. Nothing is ever deleted." />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="Mode" Margin="0,0,12,0" VerticalContentAlignment="Top"
                           IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Mirror}">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="Mirror (/MIR)" />
                  <TextBlock Style="{StaticResource Legend}">
                    <Run Text="Makes the destination an exact copy of the source, subfolders included. " /><Run FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="Deletes destination files that are not in the source." />
                  </TextBlock>
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="Mode" VerticalContentAlignment="Top"
                           IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Move}">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="Move (/MOVE)" />
                  <TextBlock Style="{StaticResource Legend}">
                    <Run Text="Copies the files, then " /><Run FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="deletes them and their folders from the source." />
                  </TextBlock>
                </StackPanel>
              </RadioButton>
            </UniformGrid>
          </StackPanel>
        </ui:Card>

        <!-- Options -->
        <UniformGrid Columns="2" Margin="-6,0,-6,6">
          <ui:Card Margin="6,0,6,6" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource CardHeader}" Text="Copy options" />
              <CheckBox Content="Include subfolders (/E)" IsChecked="{Binding IncludeSubfolders}"
                        IsEnabled="{Binding CanChooseSubfolders}"
                        ToolTipService.ShowOnDisabled="True" ToolTip="Mirror always includes subfolders" />
              <CheckBox Content="Restartable mode, resumes large files (/Z)" IsChecked="{Binding Restartable}" />
              <CheckBox Content="Skip files that are newer in the destination (/XO)" IsChecked="{Binding SkipOlder}" />
            </StackPanel>
          </ui:Card>

          <ui:Card Margin="6,0,6,6" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="3" Style="{StaticResource CardHeader}" Text="Performance and retries" />

              <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Threads (/MT)" />
              <ui:NumberBox Grid.Row="2" Margin="0,0,8,0" Minimum="1" Maximum="128" SmallChange="1" MaxDecimalPlaces="0"
                            ClearButtonEnabled="False"
                            Value="{Binding Threads, Converter={StaticResource IntToDouble}}" />

              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Retries (/R)" />
              <ui:NumberBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" Minimum="0" Maximum="1000000" SmallChange="1" MaxDecimalPlaces="0"
                            ClearButtonEnabled="False"
                            Value="{Binding Retries, Converter={StaticResource IntToDouble}}" />

              <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Wait seconds (/W)" />
              <ui:NumberBox Grid.Row="2" Grid.Column="2" Minimum="0" Maximum="3600" SmallChange="1" MaxDecimalPlaces="0"
                            ClearButtonEnabled="False"
                            Value="{Binding WaitSeconds, Converter={StaticResource IntToDouble}}" />
            </Grid>
          </ui:Card>

          <ui:Card Margin="6,6,6,6" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource CardHeader}" Text="Exclude" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Files (/XF), separated by ;" />
              <ui:TextBox Margin="0,0,0,8" PlaceholderText="*.tmp; Thumbs.db"
                          Text="{Binding ExcludeFiles, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Folders (/XD), separated by ;" />
              <ui:TextBox PlaceholderText="node_modules; $RECYCLE.BIN"
                          Text="{Binding ExcludeDirs, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </ui:Card>

          <ui:Card Margin="6,6,6,6" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource CardHeader}" Text="Run" />
              <CheckBox Content="Scan first to show total size and time left" IsChecked="{Binding PreScan}" />
              <CheckBox Content="Write a log file" IsChecked="{Binding WriteLog}" />
              <CheckBox Content="Keep the PC awake while copying" IsChecked="{Binding KeepAwake}" />
            </StackPanel>
          </ui:Card>
        </UniformGrid>

        <!-- Command preview -->
        <ui:Card Margin="0,0,0,12" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource CardHeader}" Text="Command" />
            <TextBox Grid.Row="1" Margin="0,0,8,0" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Text="{Binding CommandPreview, Mode=OneWay}" />
            <ui:Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Content="Copy"
                       Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyCommandPreviewCommand}" />
          </Grid>
        </ui:Card>
      </StackPanel>

      <ui:InfoBar Margin="0,0,0,12" IsClosable="True"
                  IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                  Title="{Binding StatusTitle}"
                  Message="{Binding StatusMessage}"
                  Severity="{Binding StatusSeverity}" />

      <!-- Progress -->
      <ui:Card Margin="0,0,0,12" Padding="16">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding PercentText}" />
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding PhaseText}" />
          </DockPanel>
          <ProgressBar Height="6" Margin="0,0,0,12" Maximum="100"
                       Value="{Binding ProgressPercent, Mode=OneWay}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource StatLabel}" Text="Files" />
            <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding FilesText}" />
            <TextBlock Grid.Column="2" Style="{StaticResource StatLabel}" Text="Data" />
            <TextBlock Grid.Column="3" Style="{StaticResource StatValue}" Text="{Binding BytesText}" />

            <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Speed" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding SpeedText}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource StatLabel}" Text="Time left" />
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource StatValue}" Text="{Binding EtaText}" />

            <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Elapsed" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
          </Grid>
          <TextBlock Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding CurrentFile}" ToolTip="{Binding CurrentFile}" />
        </StackPanel>
      </ui:Card>

      <!-- Errors -->
      <ui:Card Padding="16">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <ui:Button DockPanel.Dock="Right" Content="Copy" Icon="{ui:SymbolIcon Copy24}"
                       ToolTip="Copy the error lines to the clipboard"
                       AutomationProperties.Name="Copy errors"
                       Command="{Binding CopyErrorsCommand}" />
            <TextBlock Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"
                       Text="{Binding ErrorsHeader}" />
          </DockPanel>
          <ListBox Height="180" ItemsSource="{Binding Errors}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </StackPanel>
      </ui:Card>

    </StackPanel>
  </ScrollViewer>

  <!-- Actions: fixed at the bottom, outside the scrolling area -->
  <Border Grid.Row="1" Padding="24,12"
          Background="{DynamicResource LayerFillColorDefaultBrush}"
          BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <ui:Button Appearance="Primary" MinWidth="120" Margin="0,0,8,0"
                   Icon="{ui:SymbolIcon Play24}" Content="{Binding StartButtonText}"
                   Command="{Binding StartCommand}" />
        <ui:Button MinWidth="120" Margin="0,0,8,0" Icon="{ui:SymbolIcon Beaker24}" Content="Test run"
                   ToolTip="Show what would be copied or deleted, without changing anything (/L)"
                   Command="{Binding TestRunCommand}" />
        <ui:Button MinWidth="120" Icon="{ui:SymbolIcon Stop24}" Content="Stop"
                   Command="{Binding StopCommand}" />
      </StackPanel>

      <ui:Button DockPanel.Dock="Right" Margin="16,0,0,0" Content="Open log"
                 Icon="{ui:SymbolIcon DocumentText24}"
                 ToolTip="{Binding LastLogPath}"
                 Visibility="{Binding HasLastLog, Converter={StaticResource BoolToVisibility}}"
                 Command="{Binding OpenLogCommand}" />

      <!-- Status: live progress while running, then the outcome -->
      <StackPanel Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Tag="{Binding BarStatusSeverity}">
          <Ellipse.Style>
            <Style TargetType="Ellipse" BasedOn="{StaticResource SeverityDot}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BarStatusText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding BarStatusText}" />
      </StackPanel>
    </DockPanel>
  </Border>
  </Grid>
</Page>
