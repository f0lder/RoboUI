<Page x:Class="RoboUI.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:RoboUI.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
      Title="About"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <StackPanel Margin="24,8,24,24" MaxWidth="900" HorizontalAlignment="Stretch">

    <!-- Header -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <Image Width="64" Height="64" Margin="0,0,16,0"
             Source="pack://application:,,,/Assets/RoboUI.png"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="RoboUI" />
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <ui:Card Margin="0,0,0,12" Padding="16">
      <StackPanel>
        <TextBlock Style="{StaticResource CardHeader}" Text="What it does" />
        <TextBlock TextWrapping="Wrap"
                   Text="RoboUI is a Windows front end for robocopy. Robocopy, which is built into Windows, does all the copying. RoboUI builds the command, shows progress, and lets you stop a large copy and continue it later." />
      </StackPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,12" Padding="16">
      <StackPanel>
        <TextBlock Style="{StaticResource CardHeader}" Text="Stopping and resuming" />
        <TextBlock TextWrapping="Wrap"
                   Text="Stop ends robocopy straight away. You can then shut down the PC. Resume runs the same command again: files that are already identical in the destination are skipped, and a partly copied file is copied again (or continued, with restartable mode)." />
      </StackPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,12" Padding="16">
      <StackPanel>
        <TextBlock Style="{StaticResource CardHeader}" Text="Details" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Style="{StaticResource StatLabel}" Text="Version" />
          <TextBlock Grid.Column="1" Margin="0,0,0,6" Text="{Binding Version}" />

          <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Runtime" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Runtime}" />

          <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Robocopy" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding RobocopyPath}" />

          <TextBlock Grid.Row="3" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Text="Logs" />
          <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding LogsFolder}" ToolTip="{Binding LogsFolder}" />
          <ui:Button Grid.Row="3" Grid.Column="2" Margin="12,0,0,0" Content="Open folder"
                     Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsFolderCommand}" />
        </Grid>
      </StackPanel>
    </ui:Card>

    <ui:Card Padding="16">
      <StackPanel>
        <TextBlock Style="{StaticResource CardHeader}" Text="Built with" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="WPF UI · CommunityToolkit.Mvvm · Microsoft.Extensions.Hosting · .NET. All MIT licensed." />
      </StackPanel>
    </ui:Card>
  </StackPanel>
</Page>
