<ui:FluentWindow x:Class="RoboUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:RoboUI.Views"
        Title="RoboUI" Width="1140" Height="880" MinWidth="800" MinHeight="560"
        Icon="pack://application:,,,/Assets/RoboUI.ico"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="RoboUI">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/RoboUI.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Sidebar navigation, like the Windows Settings app: pages on top, About in the footer. -->
    <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       OpenPaneLength="200">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Home" Icon="{ui:SymbolIcon Home24}"
                               TargetPageType="{x:Type views:HomePage}" />
        <ui:NavigationViewItem Content="History" Icon="{ui:SymbolIcon History24}"
                               TargetPageType="{x:Type views:HistoryPage}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}"
                               TargetPageType="{x:Type views:AboutPage}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
