<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version gives access to Windows notifications; it still runs on Windows 10 1809 and later. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\RoboUI.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- File details shown in Explorer, and checked by code signing: product version = release tag, no "+commit" suffix. -->
    <Product>RoboUI</Product>
    <AssemblyTitle>RoboUI</AssemblyTitle>
    <Company>f0lder</Company>
    <Copyright>Copyright (c) 2026 f0lder</Copyright>
    <Description>A modern Windows front end for robocopy</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoboUI.Core\RoboUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon, generated by tools/IconGen (which also writes the vector RoboUI.svg). -->
    <Resource Include="Assets\RoboUI.ico" />
    <Resource Include="Assets\RoboUI.png" />
    <None Include="Assets\RoboUI.svg" />
  </ItemGroup>

</Project>
