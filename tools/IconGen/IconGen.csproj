<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates RoboUI's icon (SVG, ICO, PNG) from the shapes in Program.cs.
       Run from the repository root: dotnet run (project tools/IconGen), passing RoboUI/Assets as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
</Project>
